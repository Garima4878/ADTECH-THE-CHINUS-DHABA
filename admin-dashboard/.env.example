# Base URL for all REST calls.
# Leave as /api and use the Vite dev proxy (VITE_PROXY_TARGET) for local dev.
# For production build set the full origin, e.g. https://api.chinudhaba.com/api
VITE_API_BASE_URL=/api

# Dev-server only: where the Node/Express backend is running.
VITE_PROXY_TARGET=http://localhost:5000

# Customer website URL: dish photos are loaded from it (e.g. https://chinu-dhaba.netlify.app).
VITE_WEBSITE_URL=http://localhost:8080

# Prototype only: "true" opens the dashboard without a login (backend needs PROTOTYPE_OPEN_ADMIN=true).
VITE_PROTOTYPE_NO_LOGIN=
