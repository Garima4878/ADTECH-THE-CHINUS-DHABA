# Copy to .env and fill in. Never commit .env.

# Port for the AI service
PORT=4001

# Google Gemini API key (free tier) from https://aistudio.google.com/apikey
# Server-side only - never put this in frontend code.
# Leave empty to run in offline mode (rule-based answers, no AI model calls).
GEMINI_API_KEY=

# Gemini model used for the chat assistant (free-tier model)
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend menu API for live prices/availability (optional).
# Team backend: http://localhost:5000/api/menu (reads its { data: { menu: [...] } } response).
# A plain array or { "items": [...] } also works. Leave empty to use data/restaurant-knowledge-base.json only.
MENU_API_URL=

# Comma-separated frontend origins allowed to call this service (* for any, dev only)
ALLOWED_ORIGINS=*
