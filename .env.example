PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/chinu_dhaba
CLIENT_URL=http://localhost:3000
# ^ the customer website and admin dashboard URL(s), comma-separated. Required in production for CORS and payment return pages.
JWT_SECRET=your_jwt_secret_here
# Razorpay test keys (dashboard.razorpay.com -> Test Mode -> API Keys). npm run demo turns on online payment when both are set.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# First admin login for the dashboard, created by `npm run seed` when SEED_ADMIN_PASSWORD is set
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
